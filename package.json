{
  "name": "tradenet-paper-trading",
  "version": "1.2.0",
  "private": true,
  "description": "TradeNet local full-stack paper-trading platform with optional Twelve Data quotes",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
