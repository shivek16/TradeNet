    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "vite": "8.3.0"
  }
}
